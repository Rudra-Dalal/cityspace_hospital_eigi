# MongoDB connection
MONGODB_URI=mongodb://localhost:27017
MONGODB_DB_NAME=citycare
APP_ENV=development

# JWT settings — change SECRET_KEY before any real deployment
SECRET_KEY=change-me-to-a-long-random-string
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60

# CORS — Vite frontend origin
CORS_ORIGINS=http://localhost:5173

# Seeded doctor account (created on startup if missing)
DOCTOR_FIRST_NAME=Meera
DOCTOR_LAST_NAME=Kulkarni
DOCTOR_EMAIL=doctor@citycare.clinic
DOCTOR_PASSWORD=Doctor@123

# Seeded super-admin account (change both credentials before production)
SUPER_ADMIN_FIRST_NAME=Super
SUPER_ADMIN_LAST_NAME=Admin
SUPER_ADMIN_EMAIL=admin@citycare.clinic
SUPER_ADMIN_PASSWORD=Admin@123

# ---------------------------------------------------------------------------
# Gemini AI — Doctor & Patient Assistant
# Get your API key from https://aistudio.google.com/
# ---------------------------------------------------------------------------
GEMINI_API_KEY=your-gemini-api-key-here
GEMINI_MODEL=gemini-flash-latest
GEMINI_ENABLED=true
GEMINI_TIMEOUT_SECONDS=30
GEMINI_MAX_OUTPUT_TOKENS=2048
GEMINI_TEMPERATURE=0.2

# Cloudinary — required to generate persistent prescription PDF links
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# ---------------------------------------------------------------------------
# Telephony VoiceBot (Twilio + Deepgram STT + Sarvam TTS)
# Expose local FastAPI server via ngrok (e.g. ngrok http 8000)
# ---------------------------------------------------------------------------
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_PHONE_NUMBER=
PUBLIC_BASE_URL=

DEEPGRAM_API_KEY=
SARVAM_API_KEY=

# ---------------------------------------------------------------------------
# Telegram Patient Assistant
# ---------------------------------------------------------------------------
TELEGRAM_ENABLED=false
TELEGRAM_BOT_TOKEN=
TELEGRAM_MODE=polling
TELEGRAM_WEBHOOK_URL=
TELEGRAM_WEBHOOK_SECRET=
TELEGRAM_ALLOWED_USERS=
TELEGRAM_SESSION_TTL_MINUTES=240
TELEGRAM_RATE_LIMIT_PER_MINUTE=30
TELEGRAM_OTP_TTL_MINUTES=10
TELEGRAM_OTP_MAX_ATTEMPTS=3
TELEGRAM_TIMEZONE=Asia/Kolkata
TELEGRAM_WEB_APP_URL=http://localhost:5173
TELEGRAM_OTP_PROVIDER=dev

