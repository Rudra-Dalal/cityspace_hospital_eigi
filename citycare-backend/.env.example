# MongoDB connection
MONGODB_URI=mongodb://localhost:27017
MONGODB_DB_NAME=citycare

# JWT settings — change SECRET_KEY before any real deployment
SECRET_KEY=change-me-to-a-long-random-string
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60

# CORS — Vite frontend origin
CORS_ORIGINS=http://localhost:5173

# Seeded doctor account (created on startup if missing)
DOCTOR_FIRST_NAME=Meera
DOCTOR_LAST_NAME=Kulkarni
DOCTOR_EMAIL=doctor@citycare.clinic
DOCTOR_PASSWORD=Doctor@123

# ---------------------------------------------------------------------------
# Gemini AI — Doctor Assistant
# Get your API key from https://aistudio.google.com/
# ---------------------------------------------------------------------------
GEMINI_API_KEY=your-gemini-api-key-here
GEMINI_MODEL=gemini-flash-latest
GEMINI_ENABLED=true
GEMINI_TIMEOUT_SECONDS=30
GEMINI_MAX_OUTPUT_TOKENS=2048
GEMINI_TEMPERATURE=0.2

# Cloudinary — required to generate persistent prescription PDF links
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
